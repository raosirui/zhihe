# Explicit local development; never seed/create tables during import/startup.
APP_ENV=development
LOAD_DOTENV=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=zhihe
MYSQL_USER=zhihe_app
MYSQL_PASSWORD=change_me
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-a-different-long-random-secret
FRONTEND_ORIGIN=http://localhost:4000
FLASK_DEBUG=0
DEMO_SEED=0
# simulation is demo money only, not third-party payment or real withdrawal.
# Production rejects simulation, demo seeding, debug and weak JWT keys.
WALLET_MODE=disabled
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_CAPACITY=10000
FILE_USER_QUOTA=1073741824
FILE_MAX_SIZE=41943040
IMAGE_MAX_PIXELS=40000000
IMAGE_MAX_DIMENSION=16000
